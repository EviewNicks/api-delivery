{
  "info": {
    "name": "Maguru Public API - Products & Categories",
    "description": "Koleksi API test untuk public endpoints (products & categories) - digunakan untuk homepage integration dan konsumsi publik tanpa autentikasi",
    "version": "1.1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string",
      "description": "Base URL for Maguru Public API"
    },
    {
      "key": "product_id",
      "value": "67d31de1-f7a6-4e78-af34-6b2786017bb7",
      "type": "string",
      "description": "Sample product ID for testing detail endpoint"
    },
    {
      "key": "category_id",
      "value": "7f010a16-e81b-4894-adb8-28860f99d344",
      "type": "string",
      "description": "Valid category ID for testing (replace with actual ID)"
    },
    {
      "key": "created_product_id",
      "value": "",
      "type": "string",
      "description": "ID of product created via POST (auto-filled by test script)"
    }
  ],
  "item": [
    {
      "name": "Public Categories",
      "item": [
        {
          "name": "Get All Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test response structure",
                  "pm.test(\"Response has categories array\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('categories');",
                  "    pm.expect(responseJson.categories).to.be.an('array');",
                  "});",
                  "",
                  "// Test category structure (if categories exist)",
                  "pm.test(\"Category has required fields\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    if (responseJson.categories.length > 0) {",
                  "        const category = responseJson.categories[0];",
                  "        pm.expect(category).to.have.property('id');",
                  "        pm.expect(category).to.have.property('name');",
                  "        pm.expect(category).to.have.property('color');",
                  "        pm.expect(category).to.have.property('products');",
                  "        pm.expect(category).to.have.property('createdAt');",
                  "    }",
                  "});",
                  "",
                  "// Test no authentication required",
                  "pm.test(\"No authentication required\", function () {",
                  "    pm.expect(pm.response.code).to.not.eql(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Public Products",
      "item": [
        {
          "name": "Get All Products (Default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test response structure",
                  "pm.test(\"Response has products array\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('products');",
                  "    pm.expect(responseJson.products).to.be.an('array');",
                  "});",
                  "",
                  "// Test pagination",
                  "pm.test(\"Response has pagination\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('pagination');",
                  "    pm.expect(responseJson.pagination).to.have.property('page');",
                  "    pm.expect(responseJson.pagination).to.have.property('limit');",
                  "    pm.expect(responseJson.pagination).to.have.property('total');",
                  "});",
                  "",
                  "// Test product structure (if products exist)",
                  "pm.test(\"Product has required fields\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    if (responseJson.products.length > 0) {",
                  "        const product = responseJson.products[0];",
                  "        pm.expect(product).to.have.property('id');",
                  "        pm.expect(product).to.have.property('code');",
                  "        pm.expect(product).to.have.property('name');",
                  "        pm.expect(product).to.have.property('currentPrice');",
                  "        pm.expect(product).to.have.property('modalAwal');",
                  "        pm.expect(product).to.have.property('status');",
                  "        pm.expect(product).to.have.property('category');",
                  "        pm.expect(product).to.have.property('sizes');",
                  "    }",
                  "});",
                  "",
                  "// Test no sensitive data",
                  "pm.test(\"No sensitive data exposed\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    if (responseJson.products.length > 0) {",
                  "        const product = responseJson.products[0];",
                  "        pm.expect(product).to.not.have.property('totalPendapatan');",
                  "        pm.expect(product).to.not.have.property('createdBy');",
                  "        pm.expect(product).to.not.have.property('materialCost');",
                  "        pm.expect(product).to.not.have.property('materialQuantity');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/public/products",
              "host": ["{{base_url}}"],
              "path": ["api", "public", "products"]
            }
          }
        },
        {
          "name": "Get Products with Pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test pagination values",
                  "pm.test(\"Pagination reflects query params\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.pagination.page).to.eql(1);",
                  "    pm.expect(responseJson.pagination.limit).to.eql(2);",
                  "});",
                  "",
                  "// Test result count",
                  "pm.test(\"Products count respects limit\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.products.length).to.be.at.most(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/public/products?page=1&limit=2",
              "host": ["{{base_url}}"],
              "path": ["api", "public", "products"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Get Product Detail (Valid ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test product structure",
                  "pm.test(\"Product has required fields\", function () {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product).to.have.property('id');",
                  "    pm.expect(product).to.have.property('code');",
                  "    pm.expect(product).to.have.property('name');",
                  "    pm.expect(product).to.have.property('currentPrice');",
                  "    pm.expect(product).to.have.property('modalAwal');",
                  "    pm.expect(product).to.have.property('status');",
                  "    pm.expect(product).to.have.property('category');",
                  "    pm.expect(product).to.have.property('sizes');",
                  "});",
                  "",
                  "// Test category structure",
                  "pm.test(\"Category has name and color\", function () {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product.category).to.have.property('name');",
                  "    pm.expect(product.category).to.have.property('color');",
                  "});",
                  "",
                  "// Test sizes array",
                  "pm.test(\"Sizes is array with required fields\", function () {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product.sizes).to.be.an('array');",
                  "    if (product.sizes.length > 0) {",
                  "        const size = product.sizes[0];",
                  "        pm.expect(size).to.have.property('size');",
                  "        pm.expect(size).to.have.property('ageCategory');",
                  "        pm.expect(size).to.have.property('quantity');",
                  "    }",
                  "});",
                  "",
                  "// Test no sensitive data",
                  "pm.test(\"No sensitive data exposed\", function () {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product).to.not.have.property('totalPendapatan');",
                  "    pm.expect(product).to.not.have.property('createdBy');",
                  "    pm.expect(product).to.not.have.property('materialCost');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/public/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "public", "products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Create Product (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Test product created successfully",
                  "pm.test(\"Product created with correct data\", function () {",
                  "    const product = pm.response.json();",
                  "    pm.expect(product).to.have.property('id');",
                  "    pm.expect(product.code).to.eql('TEST-PUBLIC-001');",
                  "    pm.expect(product.name).to.eql('Test Product Public API');",
                  "});",
                  "",
                  "// Save product ID for PUT and DELETE tests",
                  "pm.test(\"Save product ID to variable\", function () {",
                  "    const product = pm.response.json();",
                  "    pm.collectionVariables.set('created_product_id', product.id);",
                  "});"
                ]
              }
            }
          ],
